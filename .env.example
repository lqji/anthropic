# Copy to .env and add OPENAI_API_KEY. Everything else has a working local default.
# Never commit .env.

# --- Database (compose builds DATABASE_URL for the api container from these) ---
POSTGRES_USER=clinic
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=clinic
# Used when running tests or the app outside compose (see compose.dev.yaml)
DATABASE_URL=postgresql://clinic:change-me-local-only@localhost:5432/clinic
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT_S=5

# --- LLM ---
LLM_PROVIDER=openai          # openai | fake (fake = deterministic demo mode, no key needed)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=1

# --- Clinic behaviour ---
CLINIC_TIMEZONE=Asia/Muscat
EMERGENCY_NUMBER=9999
HISTORY_WINDOW=10
INTENT_MIN_CONFIDENCE=0.6
RAG_MIN_SCORE=0.30
RAG_TOP_K=3
CLINIC_DOCS_DIR=seed/clinic_docs   # Markdown documents loaded at startup (relative to the working directory)

# --- Runtime ---
LANGGRAPH_STRICT_MSGPACK=true
APP_VERSION=0.1.0        # shown by /health and names the image; the release PR bumps it
